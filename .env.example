# Copie este arquivo para .env e preencha com a Connection String do seu Azure SQL Server.
# Formatos aceitos:
# 1) Connection String ODBC (copiada direto do Portal do Azure -> SQL Database -> Connection strings -> ODBC):
#    AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=tcp:SEU_SERVIDOR.database.windows.net,1433;Database=SEU_BANCO;Uid=SEU_USUARIO;Pwd=SUA_SENHA;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
#
# 2) URL SQLAlchemy completa:
#    AZURE_SQL_CONNECTION_STRING="mssql+pyodbc://SEU_USUARIO:SUA_SENHA@SEU_SERVIDOR.database.windows.net:1433/SEU_BANCO?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"

AZURE_SQL_CONNECTION_STRING=""

# Credenciais do sistema InfoÁguas (CETESB) usadas pelo scraper_infoaguas.py.
# Se vazias, o script solicita no terminal na hora da execução.
INFOAGUAS_EMAIL=""
INFOAGUAS_SENHA=""
